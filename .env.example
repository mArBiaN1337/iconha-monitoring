# Google Cloud Serverless Configuration (Always Free Tier: us-east1)
GCP_REGION=us-east1
GCS_PUBLIC_BUCKET=your-gcs-bucket-name-here
FUNCTION_NAME=iconha-monitoring-engine

# Local Development Server
PORT=8000

# Optional Official Brazilian Telemetry Station Codes (ANA / CEMADEN / INMET)
ANA_STATION_CODE=
CEMADEN_STATION_CODE=
